# Copy to your Writune home directory as .env, or configure these values with
# `writune config`. Real API keys belong only in .env, never config.json.
WRITUNE_PROVIDER_PRIMARY_URL=http://127.0.0.1:8317/v1
WRITUNE_PROVIDER_PRIMARY_API_KEY=YOUR_API_KEY

WRITUNE_ZH_PRIMARY=primary/model-zh-1
WRITUNE_ZH_SECONDARY=
WRITUNE_EN_PRIMARY=primary/model-en-1
WRITUNE_EN_SECONDARY=

WRITUNE_AUTO_UPDATE=true
WRITUNE_UPDATE_CHECK_SECONDS=21600

WRITUNE_MAX_CONCURRENCY=4
WRITUNE_MAX_QUEUE_SIZE=200
WRITUNE_RETRY_COUNT=1

WRITUNE_CONNECT_TIMEOUT=8
WRITUNE_FIRST_TOKEN_TIMEOUT=70
WRITUNE_INACTIVITY_TIMEOUT=20
WRITUNE_TOTAL_TIMEOUT=420
WRITUNE_MIN_TPS=6
WRITUNE_TPS_WINDOW=10
WRITUNE_TPS_WARMUP_TOKENS=30
WRITUNE_TPS_WARMUP_SECONDS=10

WRITUNE_WORKER_IDLE_SECONDS=30
WRITUNE_LEASE_SECONDS=15
WRITUNE_TASK_TTL_HOURS=24
